cabal-version:   3.0
name:            agentic-cli
version:         0.1.0.0
synopsis:        Command-line composition for agent-cat workflows
description:
  Composition root for agent-cat. It owns concrete backend grammar, strict
  layered model-definition loading, workflow registry/help/script data, the
  versioned process protocol entry points, and the @agentic-run@ executable.
  DSL, planning, cost, runtime, conformance, and concrete transports are
  independent sibling packages.

build-type:      Simple
license:         MIT
author:          John Wiegley
maintainer:      jwiegley@positron.ai

common settings
  ghc-options:      -Wall
  default-language: Haskell2010

  -- Shared by the CLI library and its cross-layer integration probes. Leaf
  -- packages declare their own smaller dependency sets.
  build-depends:
    , agentic-acp
    , agentic-acp-claude
    , agentic-acp-codex
    , agentic-acp-droid
    , agentic-agent-deck
    , agentic-cost
    , agentic-dsl
    , agentic-engine
    , agentic-plan
    , agentic-runtime
    , aeson
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , process
    , QuickCheck
    , scientific
    , stm
    , template-haskell
    , text
    , time
    , yaml
    , unix
    , vector

library
  import:          settings
  hs-source-dirs:  src
  exposed-modules:
    Agentic.Cli
    Agentic.Route
    Agentic.RoutingConfig
  other-modules:
    Agentic.Chains
    Agentic.RequirePinned
    Paths_agentic_cli
  autogen-modules: Paths_agentic_cli

-- The worked examples, written in the authoring surface — `Agentic.Workflow`,
-- which is sugar over the production one: the flagship (corpus entry
-- `example-000`), the smallest program (`example-001`), and the structured
-- representation-boundary example.
--
-- An internal library rather than separately compiled `other-modules` lists:
-- `tier1` pins the rebuilt flagship, `agentic-run` runs the same registry, and
-- `schema-probe` checks the structured example's host-side consumer. Compiling
-- these modules per executable would let the values drift under a conditional
-- or a flag and read as agreement anyway.
--
-- Cabal resolves module names to paths below `example`, hence
-- `Example.Structured` lives at `example/Example/Structured.hs`; the shorter
-- `example/Structured.hs` works on a case-insensitive machine and not on Linux.
library examples
  import:          settings
  hs-source-dirs:  example
  exposed-modules:
    Example.IsaacInfo
    Example.Registry
    Example.StructuredInfo

  build-depends:
    , agentic-cli
    , agentic-workflow-example
    , agentic-workflow-extra

-- Cross-layer conformance assembly is private test support, never a production
-- dependency of either `agentic-bisim` or the CLI library.
library verification
  ghc-options:      -Wall
  default-language: Haskell2010
  visibility:      private
  hs-source-dirs:  verification/src
  exposed-modules: Agentic.Observe
  build-depends:
    , aeson
    , agentic-bisim
    , agentic-cost
    , agentic-dsl
    , agentic-plan
    , base
    , scientific
    , text
    , vector

executable tier1
  ghc-options:      -Wall
  default-language: Haskell2010
  hs-source-dirs:  verification/tier1
  main-is:         Main.hs
  other-modules:
    CallVectors
    Cases
    LoopVectors
  build-depends:
    , aeson
    , agentic-cli:verification
    , agentic-dsl
    , agentic-plan
    , agentic-workflow-example
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , scientific
    , text
    , vector

executable bisim
  default-language: Haskell2010
  hs-source-dirs:  verification/live
  main-is:         Main.hs
  build-depends:
    , aeson
    , agentic-bisim
    , agentic-cli:verification
    , agentic-dsl
    , agentic-plan
    , base
    , bytestring
    , containers
    , QuickCheck
    , scientific
    , text
  ghc-options:     -threaded

-- The policy gate (test/PolicyProbe.hs): the seven D6/D7 probes the wave-one
-- audit ran by hand, four surface refusals, D5's executing world, D6's
-- fail-over, routing's grammar and resolution rule, and the byte identity of
-- the two prompt quoters, pinned as a program. `lake`-free and corpus-free;
-- run by ci/policies.sh.
--
-- `SurfaceRefusals` is its own module because the four programs in it are
-- written in the authoring surface, and `RebindableSyntax` — which is what an
-- authoring module is — is module-wide: a probe harness that enabled it would
-- find its own `if` reaching `Agentic.Workflow.ifThenElse`.
executable policy-probe
  import:          settings
  hs-source-dirs:  test
  main-is:         PolicyProbe.hs
  other-modules:   SurfaceRefusals
  build-depends:
    , agentic-cli
    , agentic-cli:examples
    , agentic-cli:verification
    , agentic-bisim
    , agentic-workflow-example
  ghc-options:     -threaded

-- Focused YAML routing schema, discovery, and layering regression probe.
executable routing-config-probe
  import:          settings
  hs-source-dirs:  test
  main-is:         RoutingConfigProbe.hs
  build-depends:   agentic-cli
  ghc-options:     -threaded

-- Synthetic programs for route fixed points and real stdin/control routing.
executable routing-fixed-point-probe
  import:          settings
  hs-source-dirs:  test
  main-is:         RoutingFixedPointProbe.hs
  build-depends:   agentic-cli
  ghc-options:     -threaded

-- Focused schema algebra/JSON-representation regression probe.
executable schema-probe
  import:          settings
  hs-source-dirs:  test
  main-is:         SchemaProbe.hs
  build-depends:
    , agentic-cli
    , agentic-cli:examples
    , agentic-cli:verification
    , agentic-bisim
    , agentic-workflow-example

-- The runnable surface: plan an example, price it, or run it — against the
-- scripted transport, against a live agent-deck session, or against an ACP
-- adapter it starts itself (`--engine acp`).
executable agentic-run
  import:          settings
  hs-source-dirs:  run
  main-is:         Main.hs
  build-depends:
    , agentic-cli
    , agentic-cli:examples

  -- Same reason `bisim` is threaded, one layer out. `Agentic.AgentDeck` bounds
  -- every turn with a wall clock and drains a subprocess's stderr on a second
  -- thread; a wedged session must produce a named failure rather than a hung
  -- run. `Agentic.Acp` needs it for the sharper version of the same claim: its
  -- turn budget is `System.Timeout.timeout` around a request that is blocked
  -- reading the adapter's pipe, and a read is interruptible by an asynchronous
  -- exception only under the threaded runtime.
  ghc-options:     -threaded
