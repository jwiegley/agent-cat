cabal-version:   3.0
name:            agentic
version:         0.1.0.0
synopsis:        Typed agentic workflow language, runtime, and CLI
description:
  agent-cat as one Haskell package. Source directories remain modular: DSL,
  planning, cost, runtime, engine adapters, workflows, conformance, and CLI.
  Public facades expose the supported library surface; internal components build
  examples and conformance support without exposing them to downstream users.
license:         MIT
author:          John Wiegley
maintainer:      jwiegley@positron.ai
build-type:      Simple
extra-source-files:
  nix/haskell-overrides.nix
  nix/process-close-fds-linux.patch
  cli/ci/policies.sh
  test/fixtures/runtime/descriptor-v2/*.json
  test/fixtures/runtime/descriptor-v3/*.json
  test/fixtures/runtime/frontend-manifest/*.json
  test/fixtures/runtime/input-sources/*.json
  test/fixtures/runtime/protocol-v1/*.json
  test/fixtures/runtime/protocol-v1/*.ndjson
  test/fixtures/runtime/protocol-v2/*.json
  test/fixtures/runtime/protocol-v2/*.ndjson
  test/fixtures/tui/*.golden
  test/fixtures/tui/import-boundaries.json
  test/fixtures/manager/v1/manifest.json
  test/fixtures/manager/v1/valid/*.json
  test/fixtures/manager/v1/valid/*.utf8
  test/fixtures/manager/v1/invalid/*.json
  test/fixtures/manager/v1/sse/*.sse
  test/manager_contract_probe.py
  test/source-boundaries.hs
  test/source_roots_probe.py
  test/cabal.sh
  test/cabal_env_probe.py
  test/control_probe.py
  test/lineage_probe.py
  test/person_control_probe.py
  test/person_lineage_probe.py
  test/frontend_export_probe.py
  test/frontend_io_probe.py
  test/frontend_session_probe.py
  test/frontend_contract_probe.py
  test/answer_schema_probe.py
  manager/AGENTS.md
  manager/ci/dependencies.sh
  manager/ci/contract.sh
  manager/test/DependencyProbe.hs
  manager/test/containment_probe.py
extra-doc-files:
  manager/README.md
  runtime/README.md
  doc/api/README.md
  doc/api/openapi.yaml
  doc/tui-design.md
  doc/tui-release-evidence.md

flag tui-tests
  description: Build the private PTY fixture driver
  default:     False
  manual:      True

common settings
  ghc-options:      -Wall
  default-language: Haskell2010
  build-depends:
    , aeson
    , async
    , base
    , brick
    , bytestring
    , case-insensitive
    , containers
    , crypton
    , directory
    , filepath
    , http-client
    , http-client-tls
    , http-types
    , libyaml
    , memory
    , process
    , QuickCheck
    , scientific
    , stm
    , template-haskell
    , text
    , time
    , unix
    , vty
    , vty-unix
    , vector
    , yaml

library
  import:          settings
  c-sources:       runtime/cbits/process_group.c
                   runtime/cbits/private_directory.c
                   cli/cbits/control_bootstrap.c
  hs-source-dirs:
    dsl/src
    plan/src
    cost/src
    runtime/src
    tui/src
    engine/api/src
    engine/acp/src
    engine/acp/claude/src
    engine/acp/codex/src
    engine/acp/droid/src
    engine/agent-deck/src
    cli/src
  exposed-modules:
    Agentic.Acp
    Agentic.Acp.Claude
    Agentic.Acp.Codex
    Agentic.Acp.Droid
    Agentic.AgentDeck
    Agentic.Builder
    Agentic.Cli
    Agentic.Cost
    Agentic.DSL
    Agentic.DSL.Plan
    Agentic.Engine
    Agentic.Plan
    Agentic.Planning
    Agentic.Route
    Agentic.RoutingConfig
    Agentic.Runtime
    Agentic.Runtime.Facts
    Agentic.Tui
    Agentic.Schema
    Agentic.Schema.Json
    Agentic.Schema.TH
    Agentic.WF
    Agentic.Workflow
    Agentic.Workflow.Do
  other-modules:
    Agentic.Chains
    Agentic.Cli.Frontend
    Agentic.DSL.Json
    Agentic.Exec
    Agentic.Plan.Value
    Agentic.Raw
    Agentic.RequirePinned
    Agentic.RoutingConfig.V2
    Agentic.RoutingDiscovery
    Agentic.RoutingInspect
    Agentic.RoutingSecrets
    Agentic.Runtime.Catalogue
    Agentic.Runtime.Control
    Agentic.Runtime.Descriptor
    Agentic.Runtime.Frontend
    Agentic.Runtime.Frontend.Protocol
    Agentic.Runtime.Machine
    Agentic.Runtime.Plan
    Agentic.Runtime.PrivateFile
    Agentic.Runtime.PrivateRoot
    Agentic.Runtime.ProcessGroup
    Agentic.Runtime.Protocol
    Agentic.Runtime.Route
    Agentic.Runtime.Snapshot
    Agentic.Runtime.Snapshot.Checkpoint
    Agentic.Runtime.Store
    Agentic.Tui.App
    Agentic.Tui.Client
    Agentic.Tui.Highlight
    Agentic.Tui.Model
    Agentic.Tui.Person
    Agentic.Tui.Presentation
    Agentic.Tui.Process
    Agentic.Tui.RunModel
    Agentic.Tui.Root
    Agentic.Tui.Types
    Agentic.Schema.Conformance
    Agentic.Shell
    Agentic.Text
    Agentic.World
    Paths_agentic
  autogen-modules: Paths_agentic

library examples
  import:          settings
  hs-source-dirs:
    workflow/example
    workflow/extra
    cli/example
  exposed-modules:
    Harden
    Hello
    Structured
    Isaac
    Example.IsaacInfo
    Example.Registry
    Example.StructuredInfo
  build-depends:   agentic

library bisim-support
  import:          settings
  hs-source-dirs:  bisim/haskell/src
  exposed-modules: Agentic.Bisim
  other-modules:
    Agentic.Gen
    Agentic.Guards
    Agentic.Oracle
  build-depends:   agentic

library verification
  import:          settings
  visibility:      private
  hs-source-dirs:  cli/verification/src
  exposed-modules: Agentic.Observe
  build-depends:
    , agentic
    , agentic:bisim-support

executable tier0
  import:          settings
  hs-source-dirs:  bisim/haskell/tier0
  main-is:         Main.hs
  build-depends:
    , agentic
    , agentic:bisim-support

executable tier1
  import:          settings
  hs-source-dirs:  cli/verification/tier1
  main-is:         Main.hs
  other-modules:
    CallVectors
    Cases
    LoopVectors
  build-depends:
    , agentic
    , agentic:examples
    , agentic:verification

executable bisim
  import:          settings
  hs-source-dirs:  cli/verification/live
  main-is:         Main.hs
  build-depends:
    , agentic
    , agentic:bisim-support
    , agentic:verification
  ghc-options:     -threaded

executable policy-probe
  import:          settings
  hs-source-dirs:  cli/test
  main-is:         PolicyProbe.hs
  other-modules:   SurfaceRefusals
  build-depends:
    , agentic
    , agentic:bisim-support
    , agentic:examples
    , agentic:verification
  ghc-options:     -threaded

executable routing-config-probe
  import:          settings
  hs-source-dirs:  cli/test
  main-is:         RoutingConfigProbe.hs
  build-depends:   agentic
  ghc-options:     -threaded

executable routing-v2-probe
  import:          settings
  hs-source-dirs:  cli/test
  main-is:         RoutingV2Probe.hs
  build-depends:   agentic
  ghc-options:     -threaded

executable routing-discovery-probe
  import:          settings
  hs-source-dirs:  cli/test
  main-is:         RoutingDiscoveryProbe.hs
  build-depends:
    , agentic
    , crypton-connection
    , crypton-x509-store
    , tls
  ghc-options:     -threaded

executable routing-fixed-point-probe
  import:          settings
  hs-source-dirs:  cli/test
  main-is:         RoutingFixedPointProbe.hs
  build-depends:   agentic
  ghc-options:     -threaded

executable schema-probe
  import:          settings
  hs-source-dirs:  cli/test
  main-is:         SchemaProbe.hs
  other-modules:
    AnswerSchemaProbe
    FrontendObservationTests
  build-depends:
    , agentic
    , agentic:bisim-support
    , agentic:examples
    , agentic:verification

executable agentic-run
  import:          settings
  hs-source-dirs:  cli/run
  main-is:         Main.hs
  build-depends:
    , agentic
    , agentic:examples
  ghc-options:     -threaded

test-suite engine-api-test
  import:           settings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   engine/api/test
  main-is:          Main.hs
  build-depends:
    , agentic
    , base

test-suite runtime-contract-test
  import:           settings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   runtime/test
  main-is:          Main.hs
  other-modules:
    FrontendProtocolTests
    SnapshotCheckpointTests
  ghc-options:      -threaded
  build-depends:
    , agentic
    , base

test-suite tui-model-test
  import:           settings
  type:             exitcode-stdio-1.0
  hs-source-dirs:
    tui/test
    tui/src
  main-is:          Main.hs
  other-modules:
    Agentic.Tui.Client
    Agentic.Tui.Highlight
    Agentic.Tui.Model
    Agentic.Tui.Person
    Agentic.Tui.Presentation
    Agentic.Tui.Process
    Agentic.Tui.Root
    Agentic.Tui.RunModel
    Agentic.Tui.Types
  build-depends:
    , agentic
    , base

executable tui-test-driver
  import:           settings
  if !flag(tui-tests)
    buildable:       False
  hs-source-dirs:   tui/test
  main-is:          Driver.hs
  build-depends:
    , agentic
    , base
  ghc-options:     -threaded
