cabal-version:   3.0
name:            agentic-runtime
version:         0.1.0.0
synopsis:        Engine-neutral runtime for agent-cat workflows
license:         MIT
author:          John Wiegley
maintainer:      jwiegley@positron.ai
build-type:      Simple

library
  hs-source-dirs:  src
  exposed-modules:
    Agentic.Runtime
    Agentic.Runtime.Facts

  other-modules:
    Agentic.Exec
    Agentic.Runtime.Control
    Agentic.Runtime.Machine
    Agentic.Runtime.Protocol
    Agentic.Runtime.Route
    Agentic.Runtime.Store
    Agentic.Shell
  build-depends:
    , aeson
    , agentic-engine
    , agentic-plan
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , process
    , stm
    , text
    , time
    , unix
  ghc-options:      -Wall
  default-language: Haskell2010
