cabal-version:   3.0
name:            agentic-acp
version:         0.1.0.0
synopsis:        ACP engine for agent-cat
license:         MIT
author:          John Wiegley
maintainer:      jwiegley@positron.ai
build-type:      Simple

library
  hs-source-dirs:  src
  exposed-modules:
    Agentic.Acp
  build-depends:
    , aeson
    , agentic-engine
    , base
    , bytestring
    , containers
    , directory
    , filepath
    , process
    , scientific
    , text
    , vector
  ghc-options:      -Wall
  default-language: Haskell2010
