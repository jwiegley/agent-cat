cabal-version:   3.0
name:            agentic-engine
version:         0.1.0.0
synopsis:        Engine-neutral execution API for agent-cat
license:         MIT
author:          John Wiegley
maintainer:      jwiegley@positron.ai
build-type:      Simple

library
  hs-source-dirs:  src
  exposed-modules:
    Agentic.Engine
  build-depends:
    , aeson
    , base
    , stm
    , text
  ghc-options:      -Wall
  default-language: Haskell2010

test-suite engine-api-test
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , agentic-engine
    , base
  ghc-options:      -Wall
  default-language: Haskell2010
