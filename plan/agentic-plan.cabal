cabal-version:   3.0
name:            agentic-plan
version:         0.1.0.0
synopsis:        Pure planning interpreter for agent-cat workflows
license:         MIT
author:          John Wiegley
maintainer:      jwiegley@positron.ai
build-type:      Simple

library
  hs-source-dirs:  src
  exposed-modules:
    Agentic.Plan
    Agentic.Planning

  other-modules:
    Agentic.Plan.Value
    Agentic.Schema.Conformance
    Agentic.World

  build-depends:
    , aeson
    , agentic-dsl
    , base
    , text
    , vector

  ghc-options:      -Wall
  default-language: Haskell2010
