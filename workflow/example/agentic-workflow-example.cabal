cabal-version:   3.0
name:            agentic-workflow-example
version:         0.1.0.0
synopsis:        Example agent-cat workflows
license:         MIT
author:          John Wiegley
maintainer:      jwiegley@positron.ai
build-type:      Simple

library
  hs-source-dirs:  src
  exposed-modules:
    Workflow.Example.Hello
    Workflow.Example.Structured

  build-depends:
    , agentic-dsl
    , base
    , template-haskell
    , text

  ghc-options:      -Wall
  default-language: Haskell2010
